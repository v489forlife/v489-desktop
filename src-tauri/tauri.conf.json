{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V489",
  "version": "0.1.0",
  "identifier": "app.v489.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "V489", "url": "https://v489.app/home", "width": 1280, "height": 840, "minWidth": 380, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
